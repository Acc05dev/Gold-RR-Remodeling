# Public site URL, no trailing slash. Used for canonicals, sitemap, JSON-LD and OG images.
NEXT_PUBLIC_SITE_URL=https://www.goldrrremodeling.com

# Estimate form (Resend). Without RESEND_API_KEY the form falls back to opening the visitor's mail app.
RESEND_API_KEY=
LEAD_TO_EMAIL=goldrrremodeling2@gmail.com
# Must be an address on a domain verified in Resend. onboarding@resend.dev works for testing only.
LEAD_FROM_EMAIL=Gold R.R Website <onboarding@resend.dev>

# Optional Google Analytics 4 measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
